{
  "$description": "Sumber tunggal token desain VMS. Aturan pakai: docs/18-SISTEM-DESAIN-UI.md. Ubah di sini lalu turunkan ke web/theme.css dan mobile/vms_theme.dart dalam satu commit.",
  "$version": "1.0.0",
  "$updated": "2026-09-23",

  "color": {
    "brand": {
      "50": "#eef5f2",
      "100": "#d5e8e0",
      "200": "#aed3c3",
      "300": "#7fb7a0",
      "400": "#4f977d",
      "500": "#2d7a60",
      "600": "#1f634d",
      "700": "#164d40",
      "800": "#113d33",
      "900": "#0c2d26"
    },
    "neutral": {
      "0": "#ffffff",
      "25": "#f8faf8",
      "50": "#f3f6f3",
      "100": "#e9eee9",
      "200": "#dde4de",
      "300": "#c6cfc8",
      "400": "#8a968e",
      "500": "#5f6b64",
      "600": "#4a5650",
      "700": "#36423c",
      "800": "#243b33",
      "900": "#16241f"
    },
    "status": {
      "success": { "fg": "#1e6b43", "bg": "#e8f3ec", "border": "#b9dcc6", "solid": "#23804f", "onSolid": "#ffffff" },
      "warning": { "fg": "#8a5a12", "bg": "#fcf1dd", "border": "#efd29f", "solid": "#c7892a", "onSolid": "#16241f" },
      "danger":  { "fg": "#a33a2c", "bg": "#fbecea", "border": "#f0c2ba", "solid": "#b93c2d", "onSolid": "#ffffff" },
      "info":    { "fg": "#2f5f8a", "bg": "#e8f0f8", "border": "#bcd2e8", "solid": "#3569a0", "onSolid": "#ffffff" },
      "neutral": { "fg": "#4a5650", "bg": "#e9eee9", "border": "#dde4de", "solid": "#5f6b64", "onSolid": "#ffffff" },
      "brand":   { "fg": "#164d40", "bg": "#d5e8e0", "border": "#aed3c3", "solid": "#164d40", "onSolid": "#ffffff" }
    },
    "semantic": {
      "background": "{color.neutral.50}",
      "foreground": "{color.neutral.800}",
      "heading": "{color.neutral.900}",
      "card": "{color.neutral.0}",
      "cardForeground": "{color.neutral.800}",
      "popover": "{color.neutral.0}",
      "popoverForeground": "{color.neutral.800}",
      "primary": "{color.brand.700}",
      "primaryHover": "{color.brand.600}",
      "primaryPressed": "{color.brand.800}",
      "primaryForeground": "{color.neutral.0}",
      "secondary": "{color.neutral.100}",
      "secondaryForeground": "{color.neutral.800}",
      "muted": "{color.neutral.100}",
      "mutedForeground": "{color.neutral.500}",
      "accent": "{color.brand.50}",
      "accentForeground": "{color.brand.700}",
      "destructive": "{color.status.danger.solid}",
      "destructiveForeground": "{color.neutral.0}",
      "border": "{color.neutral.200}",
      "borderHover": "{color.neutral.300}",
      "input": "{color.neutral.400}",
      "ring": "{color.brand.500}",
      "selection": "{color.brand.100}",
      "tableHeader": "{color.neutral.25}",
      "sidebar": "{color.neutral.0}",
      "sidebarActive": "{color.brand.50}",
      "scrim": "rgba(22, 36, 31, 0.48)"
    },
    "chart": ["{color.brand.700}", "{color.status.info.solid}", "{color.status.warning.solid}", "{color.neutral.500}", "{color.brand.400}"]
  },

  "font": {
    "family": {
      "sans": "Plus Jakarta Sans",
      "sansFallback": ["system-ui", "Segoe UI", "Roboto", "sans-serif"],
      "mono": ["ui-monospace", "Cascadia Mono", "Roboto Mono", "monospace"]
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "display":    { "size": 30, "lineHeight": 36, "weight": 700, "letterSpacing": "-0.02em" },
      "title-lg":   { "size": 24, "lineHeight": 32, "weight": 600, "letterSpacing": "-0.015em" },
      "title":      { "size": 20, "lineHeight": 28, "weight": 600, "letterSpacing": "-0.01em" },
      "heading":    { "size": 18, "lineHeight": 26, "weight": 600, "letterSpacing": "-0.005em" },
      "subheading": { "size": 16, "lineHeight": 24, "weight": 600, "letterSpacing": "0" },
      "body":       { "size": 16, "lineHeight": 24, "weight": 400, "letterSpacing": "0" },
      "body-sm":    { "size": 14, "lineHeight": 20, "weight": 400, "letterSpacing": "0" },
      "caption":    { "size": 12, "lineHeight": 16, "weight": 500, "letterSpacing": "0.01em" },
      "overline":   { "size": 12, "lineHeight": 16, "weight": 600, "letterSpacing": "0.06em", "textTransform": "uppercase" }
    }
  },

  "space": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "layout": {
    "gutter": { "base": 16, "md": 24, "lg": 32 },
    "cardPadding": { "base": 16, "md": 20, "lg": 24 },
    "maxWidth": { "list": 1280, "detail": 1024, "form": 720, "narrow": 400, "prose": "72ch" },
    "dialogWidth": { "sm": 480, "md": 560, "lg": 720 },
    "sidebarWidth": 256,
    "headerHeight": { "base": 56, "lg": 64 },
    "bottomNavHeight": 64
  },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },

  "size": {
    "control": 44,
    "controlLarge": 52,
    "controlSmall": 36,
    "touchTarget": 44,
    "tableRow": 52,
    "tableRowDense": 44,
    "icon": { "sm": 16, "md": 20, "lg": 24 },
    "avatar": { "sm": 32, "md": 40, "lg": 56 }
  },

  "radius": { "sm": 4, "md": 6, "lg": 8, "xl": 12, "full": 9999 },

  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(22, 36, 31, 0.06)",
    "2": "0 8px 24px rgba(22, 36, 31, 0.12)",
    "3": "0 16px 48px rgba(22, 36, 31, 0.16)"
  },

  "motion": {
    "duration": { "fast": 120, "base": 180, "slow": 240 },
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  },

  "focus": { "width": 2, "offset": 2, "color": "{color.brand.500}" },
  "opacity": { "disabled": 0.5 }
}
