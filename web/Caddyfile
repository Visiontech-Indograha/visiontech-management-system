# Caddy: TLS otomatis (bila SITE_ADDRESS berupa domain), static SPA, proxy /api ke api:8000.
# Lokal/uji: SITE_ADDRESS=:80 (tanpa TLS).
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self)"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	request_body {
		max_size 12MB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	# Berkas (URL presigned) lewat origin yang sama: API mengisi MINIO_PUBLIC_URL = domain ini,
	# sehingga CSP img-src 'self' tetap ketat dan MinIO tidak perlu port publik. Host asli ikut
	# diteruskan (bawaan Caddy) karena tanda tangan S3 mengikat host. Bucket privat → hanya URL
	# bertanda tangan yang berhasil.
	handle /{$MINIO_BUCKET:vms-files}/* {
		reverse_proxy {$MINIO_UPSTREAM:minio:9000}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
