# Salin ke api/.env (atau jalankan `bash scripts/dev-up.sh`, yang membuatnya otomatis). JANGAN commit api/.env.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:vmsdev@127.0.0.1:55433/vms_dev
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:vmsdev@127.0.0.1:55433/vms_dev
# Kunci acak khusus dev (32 byte hex): openssl rand -hex 32
JWT_PRIVATE_KEY_HEX=
JWT_KID=dev-1
DOC_SIGNING_KEY_HEX=
PUBLIC_VERIFY_URL=http://localhost:5173/verify
# MinIO lokal (docker-compose.dev-db.yml)
MINIO_ENDPOINT=127.0.0.1:19000
MINIO_ACCESS_KEY=vmsdev
MINIO_SECRET_KEY=vmsdev-secret
MINIO_SECURE=false
# Wajah: mati bawaan di dev. Nyalakan `bash scripts/dev-up.sh --wajah` hanya untuk menguji wajah.
FACE_ENROLLMENT_REQUIRED=false
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_TOKEN=
