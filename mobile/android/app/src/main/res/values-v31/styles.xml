<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API Splash Screen): latar navy + tanda Visiontech, tanpa lingkaran ikon peluncur. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/vms_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/vms_splash_bg</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/vms_splash_bg</item>
    </style>
</resources>
