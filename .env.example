# Database
# Salin ke api/.env (aplikasi) dan .env di akar (docker compose). Keduanya tidak masuk Git.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://vms_app:CHANGE_ME@db:5432/visiontech_db

# Discord Alerts
DISCORD_WEBHOOK_CI=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_DEPLOY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_ALERTS=https://discord.com/api/webhooks/...

# Security
# Access token EdDSA: seed Ed25519 32 byte (hex). Buat: python -c "import secrets;print(secrets.token_hex(32))"
JWT_PRIVATE_KEY_HEX=CHANGE_ME
JWT_KID=jwt-dev-1

# Tailscale (for deployment)
TS_OAUTH_CLIENT_ID=...
TS_OAUTH_SECRET=...

# MinIO (dok 13) — API S3 di port 9000 (9001 = konsol web). Isi nilai asli di api/.env.
MINIO_ENDPOINT=192.168.x.x:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=vms-files
MINIO_SECURE=false
