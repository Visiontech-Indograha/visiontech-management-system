        {
          "name": "06.1 - Negative Test: Update Progress Blocked by Prerequisite",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{bearer_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"progress_percent\": 50,\n  \"status\": \"IN_PROGRESS\",\n  \"completed_qty\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/work-plans/items/{{test_main_item_id}}/progress",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "work-plans",
                "items",
                "{{test_main_item_id}}",
                "progress"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update ditolak karena prasyarat belum selesai (400 Bad Request)', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Pesan galat menyebutkan prasyarat pekerjaan', function () {",
                  "    var msg = (json.error && json.error.message) || json.detail || json.message || '';",
                  "    pm.expect(msg.toLowerCase()).to.include('prasyarat');",
                  "    if (json.error && json.error.code) {",
                  "        pm.expect(json.error.code).to.eql('PREREQUISITE_NOT_MET');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
